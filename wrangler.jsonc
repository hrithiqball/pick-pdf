{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pick-pdf",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /f/* gets the noindex share-link shell instead of the home page.
    "run_worker_first": ["/api/*", "/f/*"],
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pick-pdf-files",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULT",
        "class_name": "FileVault",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FileVault"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
